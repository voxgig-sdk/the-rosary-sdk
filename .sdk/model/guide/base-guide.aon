# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 2
  metrics: count: method: 2

  entity: today: {
    path: "/v1/today": {
      op: list: method: *GET
      op: list: transform: res: *("`body.prayers`")|top
    }
  }

  entity: v1n: {
    path: "/v1/{day}": {
      op: load: method: *GET
    }
  }

}