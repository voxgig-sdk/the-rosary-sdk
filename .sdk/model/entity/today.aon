# Entity: today

main: kit: entity: today: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Description or meditation for the prayer"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "The title of the prayer or mystery"
      type: "`$STRING`"
    }
  ]

  name: "today"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v1/today"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "today"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.prayers`"
          }
        }
      ]
    }
  }



}
